# i3 config file (v4)
set $mod Mod4

font pango:JetBrainsMono Nerd Font 10
floating_modifier $mod

# Responsive key repeat for Backspace and held Vim navigation keys.
exec --no-startup-id xset r rate 250 40
exec --no-startup-id feh --bg-fill '/home/leapfrog/Pictures/wallpapers/Catppuccin-pond-bridge.jpg'

# Airy, but still compact on a laptop screen.
gaps inner 8
gaps outer 4
smart_gaps on
smart_borders on
default_border pixel 2
client.focused          #cba6f7 #cba6f7 #1e1e2e #cba6f7 #cba6f7
client.focused_inactive #313244 #313244 #a6adc8 #313244 #313244
client.unfocused        #181825 #181825 #6c7086 #181825 #181825

# Daily apps (Alt based, like an AeroSpace setup)
bindsym Mod1+i exec --no-startup-id env WINIT_X11_SCALE_FACTOR=1 alacritty
bindsym Mod1+Return exec --no-startup-id env WINIT_X11_SCALE_FACTOR=1 alacritty
bindsym Mod1+b exec --no-startup-id brave-browser
bindsym Mod1+s exec --no-startup-id slack
bindsym Mod1+x exec --no-startup-id spotify

# App search and system essentials
bindsym $mod+space exec --no-startup-id rofi -show drun
bindsym $mod+c exec --no-startup-id copyq --start-server show
bindsym $mod+Shift+v exec --no-startup-id copyq --start-server show
bindsym $mod+n exec --no-startup-id nm-connection-editor
bindsym $mod+Shift+b exec --no-startup-id blueman-manager
bindsym $mod+Escape exec --no-startup-id i3lock -c 1d2021

# Screenshots: Print selects an area; Super+Print captures the full screen.
bindsym Print exec --no-startup-id flameshot gui
bindsym $mod+Print exec --no-startup-id flameshot full -c

# Basic window management
bindsym $mod+Shift+q kill
bindsym $mod+Shift+r restart
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec i3-nagbar -t warning -m 'Exit i3?' -B 'Yes' 'i3-msg exit'

set $mode_system System: (l)ock, (s)uspend, (r)eboot, (p)ower off, (Esc) cancel
mode "$mode_system" {
    bindsym l exec --no-startup-id /home/leapfrog/.config/i3/scripts/power-lock
    bindsym s exec --no-startup-id /home/leapfrog/.config/i3/scripts/power-suspend
    bindsym r exec --no-startup-id /home/leapfrog/.config/i3/scripts/power-reboot
    bindsym p exec --no-startup-id /home/leapfrog/.config/i3/scripts/poweroff
    bindsym Escape mode "default"
    bindsym Return mode "default"
}
bindsym $mod+Shift+p mode "$mode_system"

# Splitting and layouts
bindsym $mod+v split h
bindsym $mod+d split v
bindsym $mod+e layout toggle split
bindsym $mod+w kill
bindsym $mod+t layout tabbed
bindsym $mod+f fullscreen toggle

# Focus movement
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move windows
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9

# Resize mode
mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

bar {
    status_command i3status -c ~/.config/i3/i3status.conf
    position top
    tray_output primary
    font pango:JetBrainsMono Nerd Font 10
    colors {
        background #181825
        statusline #cdd6f4
        separator  #45475a
        focused_workspace  #cba6f7 #cba6f7 #1e1e2e
        active_workspace   #313244 #313244 #cdd6f4
        inactive_workspace #181825 #181825 #6c7086
        urgent_workspace   #f38ba8 #f38ba8 #1e1e2e
    }
}

exec --no-startup-id nm-applet
exec --no-startup-id blueman-applet
exec --no-startup-id dunst
exec --no-startup-id picom
exec --no-startup-id copyq --start-server
